{
  "name": "moron-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "description": "Personal pi extension with an in-process destructive-command scanner.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jeecabs/moron-guard.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "schemas",
    "package.json",
    "tsconfig.json"
  ],
  "exports": {
    ".": "./src/api.ts",
    "./core": "./src/core/index.ts",
    "./diagnostics": "./src/diagnostics.ts"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "safety"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.6"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
